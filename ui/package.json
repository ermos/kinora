{
  "name": "kinora-ui",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "hls.js": "^1.7.3",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@^0.86.3-0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/react": "~19.2.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../internal/api/docs/swagger.json -o src/api/schema.ts",
    "tv:prebuild": "EXPO_TV=1 expo prebuild --platform android --clean",
    "tv:android": "npm run tv:prebuild && expo run:android",
    "tv:apk": "npm run tv:prebuild && cd android && ./gradlew assembleRelease"
  },
  "private": true
}
