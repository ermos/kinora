{
  "name": "kinora-ui",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "expo": "~58.0.0",
    "expo-build-properties": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-image": "~58.0.0",
    "expo-intent-launcher": "~58.0.0",
    "expo-linear-gradient": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-video": "~58.0.0",
    "hls.js": "^1.7.3",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@^0.86.3-0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/react": "~19.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../internal/api/docs/swagger.json -o src/api/schema.ts",
    "tv:prebuild": "EXPO_TV=1 expo prebuild --platform android --clean",
    "tv:android": "npm run tv:prebuild && expo run:android",
    "tv:apk": "npm run tv:prebuild && cd android && ./gradlew assembleRelease"
  },
  "private": true
}
