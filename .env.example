# Required: free TMDB key, https://www.themoviedb.org/settings/api (v3 key or v4 read token)
TMDB_API_KEY=
ADDR=:8080
# PostgreSQL; docker compose sets it to its own postgres service
DATABASE_URL=postgres://kinora:kinora@localhost:5432/kinora?sslmode=disable

# Android release builds only (cd ui && npm run tv:apk): the key updates must be signed with
# KINORA_KEYSTORE=/path/to/release.keystore
# KINORA_KEYSTORE_PASSWORD=
# KINORA_KEY_ALIAS=kinora
